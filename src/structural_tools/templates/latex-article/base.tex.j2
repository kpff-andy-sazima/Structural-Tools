            \put(517, -50){\parbox{72pt}{\centering\small \thepage{} of \pageref*{LastPage}}}

            ((* if 'job_number' in nb.metadata *))
            \put(517, -87){\parbox{72pt}{\centering\small ((( nb.metadata.job_number ))) }}
